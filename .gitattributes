# Normalise line endings; shell scripts and SQL must always use LF.
* text=auto eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf

# Binary assets (never diffed or converted)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
