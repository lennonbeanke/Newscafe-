# Variable NAMES only. backend/scripts/gen-api-env.sh creates backend/.env.admin with random DEVELOPMENT secrets (git-ignored).
# The ADMIN process holds only the admin database login and the two keys. It refuses to start if it can see any public setting.
APP_ENV=development
API_ADMIN_PORT=8788
API_DB_HOST=127.0.0.1
API_DB_PORT=54329
API_DB_NAME=newscafe_dev
API_DB_ADMIN_USER=newscafe_admin
API_DB_ADMIN_PASSWORD=
API_HMAC_KEY=
API_ADMIN_ALLOWED_ORIGIN=http://localhost:3000
