# Variable NAMES only. backend/scripts/gen-api-env.sh creates backend/.env.public with a random DEVELOPMENT secret (git-ignored).
# The PUBLIC process holds only the public database login. It refuses to start if it can see any admin setting.
APP_ENV=development
API_PORT=8787
API_DB_HOST=127.0.0.1
API_DB_PORT=54329
API_DB_NAME=newscafe_dev
API_DB_PUBLIC_USER=newscafe_public
API_DB_PUBLIC_PASSWORD=
API_ALLOWED_ORIGIN=http://localhost:3000
API_OUTBOX_DIR=backend/.outbox
# optional: shown to guests when booking is unavailable
# API_CONTACT_PHONE=
# API_CONTACT_EMAIL=
